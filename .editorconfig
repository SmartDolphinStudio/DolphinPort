# EditorConfig helps developers define and maintain consistent coding styles
# between different editors and IDEs: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{dart,yaml,yml,json,xml,kt,rs,gradle,properties}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
